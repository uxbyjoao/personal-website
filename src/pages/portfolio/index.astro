---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

const portfolioProjects = await getCollection("portfolio", ({ data }) => {
  return !data.draft;
});

// Sort by date (newest first)
portfolioProjects.sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime()
);

const formatDate = (date: Date) => {
  const options: Intl.DateTimeFormatOptions = {
    year: "numeric",
    month: "long",
    day: "numeric",
  };
  return new Date(date).toLocaleDateString("en-US", options);
};

const description =
  "Private portfolio showcasing confidential design work and case studies.";
---

<BaseLayout title="Portfolio" description={description} heading="Portfolio">
  <p class="mb-10 text-stone-600 dark:text-stone-400">
    These are confidential case studies and work samples. Please do not share
    access.
  </p>

  {
    portfolioProjects.length === 0 ? (
      <p class="text-stone-500 dark:text-stone-400">
        No portfolio projects available yet.
      </p>
    ) : (
      <ul class="space-y-10">
        {portfolioProjects.map((project) => (
          <li>
            <a href={`/portfolio/${project.slug}`}>
              <h2 class="underlined-link text-2xl font-medium">
                {project.data.title}
              </h2>
            </a>
            <div class="mt-2 flex flex-wrap gap-4 text-xs uppercase tracking-wider text-stone-500 dark:text-stone-400">
              <p>{formatDate(project.data.datePublished)}</p>
              {project.data.client && <p>Client: {project.data.client}</p>}
              {project.data.role && <p>Role: {project.data.role}</p>}
            </div>
            {project.data.lead && <p class="mt-3">{project.data.lead}</p>}
            {project.data.tags && (
              <div class="mt-3 flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <span class="rounded bg-stone-200 px-2 py-1 text-xs dark:bg-stone-700">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-16 border-t border-stone-200 pt-8 dark:border-stone-700">
    <form action="/portfolio/logout" method="POST">
      <button
        type="submit"
        class="text-sm text-stone-500 transition-colors hover:text-red-500"
      >
        Logout
      </button>
    </form>
  </div>
</BaseLayout>
