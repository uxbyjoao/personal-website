---
interface ImageItem {
  src: string;
  alt: string;
}

interface Props {
  images: ImageItem[];
}

const { images } = Astro.props;
---

<div class="my-10 not-prose masonry-grid">
  {images.map((img) => (
    <img
      src={img.src}
      alt={img.alt}
      loading="lazy"
      data-lightbox
      class="w-full h-full object-cover rounded-lg border border-edge cursor-zoom-in transition-opacity duration-200 hover:opacity-90"
    />
  ))}
</div>

<style>
  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 160px;
    gap: 0.75rem;
  }
  .masonry-grid > :first-child {
    grid-row: span 2;
  }
  @media (max-width: 639px) {
    .masonry-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 140px;
    }
  }
</style>
