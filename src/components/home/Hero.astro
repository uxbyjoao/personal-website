---
---

<section class="hero relative flex h-screen flex-col justify-end overflow-hidden pt-16">
  <!-- Dithered background -->
  <div class="absolute inset-0 z-0">
    <canvas
      id="dither-canvas"
      aria-hidden="true"
      class="absolute inset-0 h-full w-full"
      style="image-rendering: pixelated; image-rendering: crisp-edges;"
    ></canvas>

    <!-- To use a real video source, uncomment and set the src: -->
    <!-- <video id="dither-video" src="/video.mp4" muted autoplay loop playsinline preload="auto" crossorigin="anonymous" class="hidden" aria-hidden="true"></video> -->

    <!-- Bottom fade for text readability -->
    <div
      class="absolute inset-x-0 bottom-0 h-3/5 bg-linear-to-t from-canvas via-canvas/85 to-transparent"
    ></div>
  </div>

  <!-- Bottom content bar -->
  <div
    class="hero-content relative z-10 px-6 pb-10 sm:px-10 md:px-16 lg:px-20 md:pb-14"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-hero items-end gap-10 md:gap-16"
    >
      <!-- Left: headline block -->
      <div>
        <p
          class="hero-label mb-5 font-mono text-label uppercase tracking-label-wide text-muted"
        >
          Jo&atilde;o Gomes &mdash; Berlin
        </p>
        <h1
          class="hero-heading font-display text-hero font-extrabold leading-hero tracking-heading text-primary"
        >
          Senior UX Designer<br />crafting <span class="text-accent"
            >digital clarity</span
          >
        </h1>
        <p
          class="hero-sub mt-5 max-w-prose-narrow font-mono text-detail font-light leading-relaxed text-secondary"
        >
          Design systems, e-commerce, and the space between design and code.
        </p>
      </div>

      <!-- Right: CTA + scroll hint -->
      <div
        class="flex flex-row items-start gap-6 md:flex-col md:items-end md:gap-8 md:pb-1"
      >
        <div class="flex items-center gap-3">
          <a
            href="/portfolio"
            class="hero-cta rounded-sm bg-accent px-5 py-2.5 font-display text-label font-bold uppercase tracking-label text-accent-on transition-colors duration-200 hover:bg-accent-active"
          >
            Explore Work
          </a>
          <a
            href="/experience"
            class="hero-cta rounded-sm border border-edge px-5 py-2.5 font-display text-label font-bold uppercase tracking-label text-primary transition-colors duration-200 hover:border-muted"
          >
            Experience
          </a>
        </div>
        <a
          href="#after-hero"
          class="hero-scroll group flex items-center gap-2 font-mono text-label text-muted transition-colors duration-200 hover:text-secondary"
        >
          <span>Scroll to explore</span>
          <svg
            class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-y-0.5"
            viewBox="0 0 14 14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 1v12M1 7l6 6 6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Anchor for scroll-to -->
<div id="after-hero"></div>

<style>
  /* Staggered entrance animations */
  .hero-label,
  .hero-heading,
  .hero-sub,
  .hero-cta,
  .hero-scroll {
    opacity: 0;
    transform: translateY(16px);
    animation: heroReveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-label {
    animation-delay: 0.15s;
  }
  .hero-heading {
    animation-delay: 0.3s;
  }
  .hero-sub {
    animation-delay: 0.45s;
  }
  .hero-cta {
    animation-delay: 0.6s;
  }
  .hero-scroll {
    animation-delay: 0.75s;
  }

  @keyframes heroReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Smooth scroll for anchor link */
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  import { initDitherBackground } from "../../scripts/dither-background";

  let cleanup: (() => void) | undefined;

  function boot() {
    cleanup?.();
    const canvas = document.getElementById(
      "dither-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    const video = document.getElementById(
      "dither-video",
    ) as HTMLVideoElement | null;
    cleanup = initDitherBackground(canvas, video ?? undefined);
  }

  // Run on initial load and after view transitions
  boot();
  document.addEventListener("astro:after-swap", boot);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
