---
type Props = {
  skills: string[];
};

const { skills } = Astro.props;
---

<div class="flex flex-wrap gap-1.5 mt-4">
  {skills.map((skill) => (
    <span class="font-mono text-[11px] text-[var(--text-secondary)] bg-[rgba(255,255,255,0.04)] border border-[var(--border)] px-3 py-1 rounded">
      {skill}
    </span>
  ))}
</div>
