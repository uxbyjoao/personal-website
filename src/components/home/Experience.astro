---
import { experience } from "@data";
import SkillsList from "./SkillsList.astro";

type Props = {
  keyOnly?: boolean;
};

const { keyOnly = false } = Astro.props;
const entries = keyOnly ? experience.filter((e) => e.key) : experience;
---

<section class="mx-auto max-w-3xl px-6 py-24">
  <h2 class="font-display text-heading-lg font-extrabold text-primary mb-12">
    {keyOnly ? "Key Experience" : "Experience"}
  </h2>
  <div class="flex flex-col gap-4">
    {entries.map((entry) => (
      <article data-reveal class="bg-surface border border-edge rounded-lg p-8 transition-all duration-200 hover:bg-surface-elevated hover:-translate-y-0.5">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <span class="font-mono text-label uppercase tracking-label text-muted">
            {entry.startDate} — {entry.endDate}
          </span>
          <span class="font-mono text-label uppercase tracking-label text-muted">
            {entry.location}
          </span>
        </div>
        <h3 class="font-display text-heading-sm font-extrabold text-primary mt-3">
          {entry.title}
        </h3>
        <p class="font-mono text-sm mt-1">
          <span class="text-accent">{entry.company}</span>
        </p>
        <ul class="mt-4 flex flex-col gap-2">
          {entry.description.map((desc) => (
            <li class="font-mono text-detail font-light text-secondary leading-relaxed">
              {desc}
            </li>
          ))}
        </ul>
        <SkillsList skills={entry.skills} />
      </article>
    ))}
  </div>
  {keyOnly && (
    <div class="mt-8 text-center">
      <a
        href="/experience"
        class="font-mono text-sm text-accent border-b border-accent pb-0.5 hover:text-accent-active transition-colors duration-200"
      >
        See full experience &rarr;
      </a>
    </div>
  )}
</section>
