---
import { education } from "@data";
---

<section class="mx-auto max-w-3xl px-6 py-24">
  <h2 class="font-display text-heading-lg font-extrabold text-primary mb-16">
    Education
  </h2>

  <div class="relative">
    {/* Timeline spine */}
    <div
      class="absolute left-1 top-2 bottom-2 w-px"
      style="background: linear-gradient(to bottom, var(--color-edge), transparent)"
    />

    <div class="flex flex-col gap-14">
      {education.map((entry) => {
        const isOngoing = entry.endDate === "Ongoing";
        return (
          <article data-reveal class="relative pl-10 group">
            {/* Timeline node */}
            <div
              class:list={[
                "absolute left-0 top-2.5 size-2.25 rounded-full transition-all duration-300",
                isOngoing
                  ? "bg-accent shadow-[0_0_0_4px_rgba(212,50,29,0.15)]"
                  : "bg-edge-subtle border border-edge group-hover:border-accent group-hover:bg-accent/20",
              ]}
            >
              {isOngoing && (
                <span class="absolute -inset-1.25 rounded-full border border-accent/25 timeline-pulse" />
              )}
            </div>

            {/* Content */}
            <span
              class:list={[
                "font-mono text-label uppercase tracking-label",
                isOngoing ? "text-accent" : "text-muted",
              ]}
            >
              {entry.endDate}
            </span>
            <h3 class="font-display text-xl font-semibold text-primary mt-2">
              {entry.institution}
            </h3>
            <p class="font-mono text-label uppercase tracking-label text-muted mt-1">
              {entry.location}
            </p>
            <ul class="mt-3 flex flex-col gap-2">
              {entry.description.map((desc) => (
                <li class="font-mono text-detail font-light text-secondary leading-relaxed">
                  {desc}
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>
  </div>
</section>
