---
import { education } from "@data";
---

<section class="mx-auto max-w-3xl px-6 py-24">
  <h2 class="font-display text-heading-lg font-extrabold text-primary mb-12">
    Education
  </h2>
  <div class="flex flex-col gap-4">
    {education.map((entry) => (
      <article data-reveal class="bg-surface border border-edge rounded-lg p-8">
        <span class="font-mono text-label uppercase tracking-label text-muted">
          {entry.endDate}
        </span>
        <h3 class="font-display text-xl font-semibold text-primary mt-2">
          {entry.institution}
        </h3>
        <p class="font-mono text-label uppercase tracking-label text-muted mt-1">
          {entry.location}
        </p>
        <ul class="mt-3 flex flex-col gap-2">
          {entry.description.map((desc) => (
            <li class="font-mono text-detail font-light text-secondary leading-relaxed">
              {desc}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
