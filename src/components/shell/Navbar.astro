---
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/experience", label: "Experience" },
];
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-nav duration-300" style="background: transparent; border-bottom: 1px solid transparent; backdrop-filter: blur(0px);">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <!-- Logo -->
    <a href="/" class="font-display text-base font-extrabold text-primary hover:text-accent transition-colors duration-200">
      JG
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-6 md:flex">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            "font-mono text-label uppercase tracking-label transition-colors duration-200",
            isActive(href) ? "text-accent" : "text-muted hover:text-primary",
          ]}
        >
          {label}
        </a>
      ))}
      <a
        href="/portfolio"
        class="font-display text-label font-extrabold uppercase tracking-label-tight bg-accent text-accent-on px-3.5 py-1.5 rounded-sm transition-colors duration-200 hover:bg-accent-active"
      >
        Portfolio
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-primary p-1"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
</nav>

<!-- Mobile overlay menu -->
<div id="mobile-menu" class="fixed inset-0 z-menu flex flex-col items-center justify-center gap-8 transition-all duration-300" style="background: var(--color-canvas); opacity: 0; pointer-events: none; visibility: hidden;" role="dialog" aria-modal="true" aria-label="Navigation">
  <button id="mobile-menu-close" class="absolute top-5 right-6 text-primary p-1" aria-label="Close menu">
    <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  {navLinks.map(({ href, label }) => (
    <a
      href={href}
      class:list={[
        "font-mono text-sm uppercase tracking-label-wide transition-colors duration-200",
        isActive(href) ? "text-accent" : "text-muted hover:text-primary",
      ]}
    >
      {label}
    </a>
  ))}
  <a
    href="/portfolio"
    class="font-display text-sm font-extrabold uppercase tracking-label bg-accent text-accent-on px-6 py-2.5 rounded-sm transition-colors duration-200 hover:bg-accent-active"
  >
    Portfolio
  </a>
</div>

<script is:inline>
  // Navbar scroll effect
  function initNavScroll() {
    if (window.__navScrollHandler) {
      window.removeEventListener("scroll", window.__navScrollHandler);
      window.__navScrollHandler = null;
    }
    var nav = document.getElementById("main-nav");
    if (!nav) return;
    var scrolled = null;
    function updateNav() {
      var shouldShow = window.scrollY > 10;
      if (shouldShow === scrolled) return;
      scrolled = shouldShow;
      if (shouldShow) {
        nav.style.background = "color-mix(in srgb, var(--color-canvas) 80%, transparent)";
        nav.style.borderBottomColor = "var(--color-edge-subtle)";
        nav.style.backdropFilter = "blur(20px)";
      } else {
        nav.style.background = "transparent";
        nav.style.borderBottomColor = "transparent";
        nav.style.backdropFilter = "blur(0px)";
      }
    }
    window.__navScrollHandler = updateNav;
    window.addEventListener("scroll", updateNav, { passive: true });
    updateNav();
  }
  initNavScroll();

  document.addEventListener("astro:page-load", function() {
    initNavScroll();

    // Mobile menu
    var menuBtn = document.getElementById("mobile-menu-btn");
    var menuClose = document.getElementById("mobile-menu-close");
    var menu = document.getElementById("mobile-menu");

    function openMenu() {
      if (menu) {
        menu.style.opacity = "1";
        menu.style.pointerEvents = "auto";
        menu.style.visibility = "visible";
      }
      if (menuBtn) menuBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      menuClose?.focus();
    }

    function closeMenu() {
      if (menu) {
        menu.style.opacity = "0";
        menu.style.pointerEvents = "none";
        menu.style.visibility = "hidden";
      }
      if (menuBtn) menuBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      menuBtn?.focus();
    }

    menuBtn?.addEventListener("click", openMenu);
    menuClose?.addEventListener("click", closeMenu);

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape" && menu?.style.opacity === "1") closeMenu();
    });
  });
</script>
