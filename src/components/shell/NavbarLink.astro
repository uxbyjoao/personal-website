---
interface Props {
  href: string;
  newWindow?: boolean;
}

const { href, newWindow } = Astro.props;

function checkPathName(href: string) {
  if (href === "/") {
    return Astro.url.pathname === "/";
  }
  return Astro.url.pathname.includes(href);
}
---

<a
  role="menuitem"
  class:list={[
    "hover:text-blue-500 dark:hover:text-blue-500 transition-colors text-sm px-2 py-2 rounded-md font-medium inline-flex items-center gap-1",
    {
      "bg-blue-500/10 text-blue-500": checkPathName(href),
    },
    {
      "text-stone-700 dark:text-stone-50": !checkPathName(href),
    },
  ]}
  href={href}
  rel="prefetch"
  target={newWindow ? "_blank" : "_self"}
  ><slot /> {newWindow && <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>}</
>
