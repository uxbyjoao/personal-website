---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}

const { src, caption, alt, width, height } = Astro.props;
---
<figure>
  <Image
    src={src}
    alt={alt}
    width={width || src.width}
    height={height || src.height}
    class="rounded-md"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
